# Optional: TMDb v4 API read-access token. Jikan works without a token.
WATCHTRACKER_TMDB_TOKEN=
WATCHTRACKER_DATABASE_PATH=data/watchtracker.sqlite3
WATCHTRACKER_CACHE_DIR=cache
WATCHTRACKER_CACHE_TTL_SECONDS=21600
WATCHTRACKER_CACHE_MAX_ENTRIES=500
WATCHTRACKER_RELEASE_CHECK_INTERVAL_MINUTES=360
WATCHTRACKER_RELEASE_SYNC_BATCH_SIZE=20
WATCHTRACKER_RELEASE_SCHEDULER_ENABLED=true
# AniList's current terms restrict competing trackers. Leave disabled unless you
# have confirmed your use is authorized; Jikan anime search remains available.
WATCHTRACKER_ANILIST_ENABLED=false
WATCHTRACKER_LANGUAGE=en-US
WATCHTRACKER_REGION=US
# IANA timezone, for example Europe/Stockholm. Blank uses the system timezone.
WATCHTRACKER_TIMEZONE=
WATCHTRACKER_UPLOAD_LIMIT_MB=20
# Full-library backups may be larger than CSV imports. They are streamed through a
# spooled temporary file instead of being held in application memory.
WATCHTRACKER_BACKUP_UPLOAD_LIMIT_MB=512
WATCHTRACKER_IMPORT_MAX_MEMBERS=50
WATCHTRACKER_IMPORT_MAX_ROWS=100000
WATCHTRACKER_IMPORT_MAX_CELL_CHARS=100000
WATCHTRACKER_IMPORT_MAX_DECOMPRESSED_MB=100
WATCHTRACKER_LOG_LEVEL=INFO
WATCHTRACKER_HOST=127.0.0.1
WATCHTRACKER_PORT=8000
# Keep local unless you have completed Settings → Access & Devices and the
# docs/SELF_HOSTING.md HTTPS/authentication checklist.
WATCHTRACKER_ACCESS_MODE=local
# Server-only values intentionally have no usable example secret.
WATCHTRACKER_PUBLIC_BASE_URL=
WATCHTRACKER_APPLICATION_SECRET=
WATCHTRACKER_TRUSTED_HOSTS=
WATCHTRACKER_TRUSTED_PROXY_IPS=
WATCHTRACKER_SESSION_TTL_HOURS=168
WATCHTRACKER_SERVER_BACKUP_INTERVAL_HOURS=24
WATCHTRACKER_SERVER_BACKUP_RETENTION=14
