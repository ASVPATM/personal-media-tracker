# Copy this file to server.env, replace every placeholder, and chmod it to 0600.
# Generate each secret independently, for example: python -c "import secrets; print(secrets.token_urlsafe(64))"
WATCHTRACKER_ACCESS_MODE=server
WATCHTRACKER_PUBLIC_BASE_URL=https://tracker.example.com
WATCHTRACKER_APPLICATION_SECRET=REPLACE_WITH_A_RANDOM_64_PLUS_CHARACTER_VALUE
WATCHTRACKER_SERVER_BOOTSTRAP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_ONE_TIME_VALUE
WATCHTRACKER_TRUSTED_HOSTS=tracker.example.com
WATCHTRACKER_TRUSTED_PROXY_IPS=172.30.0.3
WATCHTRACKER_SERVER_BACKUP_INTERVAL_HOURS=24
WATCHTRACKER_SERVER_BACKUP_RETENTION=14
# Optional PostgreSQL deployment (compose.postgres.yaml):
# POSTGRES_USER=pmt
# POSTGRES_DB=pmt
# POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
# WATCHTRACKER_DATABASE_URL_OVERRIDE=postgresql+psycopg://pmt:REPLACE_WITH_URL_SAFE_PASSWORD@database:5432/pmt
